{
  "name": "forma-dashboard-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts --production",
    "build": "pnpm typecheck && vite build",
    "build:demo": "pnpm typecheck && vite build --mode portfolio",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4176",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/dm-sans": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.1.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
